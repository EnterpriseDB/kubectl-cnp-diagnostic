#!/usr/bin/env bash
# ============================================================
#  EDB / Postgres Cluster Diagnostic Collector (kubectl-edbdiag)
#  Supports:
#    1) CNP   - EDB Postgres for Kubernetes
#    2) CNPG  - CloudNativePG (community)
#    3) PGD4K - EDB Postgres Distributed for Kubernetes
#  Works against plain Kubernetes (kubectl) or OpenShift (oc) - auto-detected.
# ============================================================

set -uo pipefail

# ------------------------------------------------------------
# VERSION - bump EDBDIAG_VERSION/EDBDIAG_RELEASED by hand with every
# meaningful change pushed to main. Unlike the `kubectl cnpg`/`kubectl cnp`
# plugins (compiled Go binaries with build-time-injected Version/Commit/Date),
# this is a plain shell script fetched straight from GitHub, so there is no
# build step to stamp a commit hash into it automatically. Instead,
# `kubectl edbdiag version` also prints this exact file's own SHA-256, so
# anyone can diff their copy against main byte-for-byte without guessing
# whether they're on the latest fix.
# ------------------------------------------------------------
EDBDIAG_VERSION="1.1.1"
EDBDIAG_RELEASED="2026-09-21"

print_version() {
    local self_sha=""
    if command -v sha256sum &>/dev/null; then
        self_sha=$(sha256sum "$0" 2>/dev/null | awk '{print $1}')
    elif command -v shasum &>/dev/null; then
        self_sha=$(shasum -a 256 "$0" 2>/dev/null | awk '{print $1}')
    fi
    echo "kubectl-edbdiag version ${EDBDIAG_VERSION} (released ${EDBDIAG_RELEASED})"
    if [ -n "$self_sha" ]; then
        echo "SHA256:  ${self_sha}"
    fi
    echo "Compare against: https://raw.githubusercontent.com/EnterpriseDB/kubectl-cnp-diagnostic/main/kubectl-edbdiag"
}

# ------------------------------------------------------------
# ARGUMENT PARSING (all optional - lets this run unattended, e.g.
# looped across many remote clusters from one bastion/login session:
#   for ctx in $(oc config get-contexts -o name); do
#       oc config use-context "$ctx"
#       kubectl edbdiag --variant pgd4k --scope all -y
#   done
# Any flag left out just falls back to its original interactive prompt.
# ------------------------------------------------------------
PRESET_VARIANT=""
PRESET_SCOPE=""
PRESET_NAMESPACE=""
PRESET_CLUSTER=""
NONINTERACTIVE=false

print_usage() {
    cat <<'USAGE'
Usage: kubectl edbdiag [OPTIONS]

Run with no options for the original interactive prompts. Every option
below only overrides the one prompt it corresponds to - mix and match,
or supply all of them for a fully unattended run.

  --variant=cnp|cnpg|pgd4k       Operator variant (skips the variant menu)
  --scope=all|namespace|single   Collection scope (skips the scope menu)
                                    all       - every cluster/node found
                                    namespace - every cluster in --namespace
                                    single    - exactly --namespace + --cluster
  --namespace=NAME                Required for scope=namespace or scope=single
  --cluster=NAME                  Required for scope=single
  -y, --yes, --non-interactive    Fail fast instead of prompting if
                                   --variant or --scope wasn't also given
  version, -v, --version          Print the script version + its own
                                   SHA-256 (to confirm you're on the
                                   latest fix from GitHub) and exit
  -h, --help                      Show this help and exit

Examples:
  # One specific CNP cluster, no prompts:
  kubectl edbdiag --variant cnp --scope single --namespace prod --cluster pg-main -y

  # Every PGD4K node/cluster reachable in the current context:
  kubectl edbdiag --variant pgd4k --scope all -y

  # Loop across several remote OpenShift clusters from one bastion host:
  while IFS=, read -r server token; do
      oc login --token="$token" --server="$server" >/dev/null
      kubectl edbdiag --variant pgd4k --scope all -y
  done < clusters.csv
USAGE
}

while [ $# -gt 0 ]; do
    case "$1" in
        --variant=*)   PRESET_VARIANT="${1#*=}" ;;
        --variant)     PRESET_VARIANT="${2:-}"; shift ;;
        --scope=*)     PRESET_SCOPE="${1#*=}" ;;
        --scope)       PRESET_SCOPE="${2:-}"; shift ;;
        --namespace=*) PRESET_NAMESPACE="${1#*=}" ;;
        --namespace)   PRESET_NAMESPACE="${2:-}"; shift ;;
        --cluster=*)   PRESET_CLUSTER="${1#*=}" ;;
        --cluster)     PRESET_CLUSTER="${2:-}"; shift ;;
        -y|--yes|--non-interactive) NONINTERACTIVE=true ;;
        -v|--version|version) print_version; exit 0 ;;
        -h|--help) print_usage; exit 0 ;;
        *)
            echo "ERROR: Unrecognized option '$1'. Use --help for usage." >&2
            exit 1
            ;;
    esac
    shift
done

PRESET_VARIANT=$(echo "$PRESET_VARIANT" | tr '[:upper:]' '[:lower:]')
PRESET_SCOPE=$(echo "$PRESET_SCOPE" | tr '[:upper:]' '[:lower:]')

# In unattended mode, missing required flags must fail fast here rather
# than falling through to a `read` that has no terminal to read from
# (which would silently take an empty default instead of erroring).
if [ "$NONINTERACTIVE" = true ]; then
    [ -z "$PRESET_VARIANT" ] && { echo "ERROR: --non-interactive requires --variant=cnp|cnpg|pgd4k." >&2; exit 1; }
    [ -z "$PRESET_SCOPE" ]   && { echo "ERROR: --non-interactive requires --scope=all|namespace|single." >&2; exit 1; }
fi

# ------------------------------------------------------------
# 0. PRE-FLIGHT CHECKS + CLI DETECTION (oc vs kubectl)
# ------------------------------------------------------------
check_cmd() {
    if ! command -v "$1" &>/dev/null; then
        echo "ERROR: Required command '$1' not found. Please install it and re-run."
        exit 1
    fi
}
check_cmd tar

# Prefer `oc` only when it's installed AND the current context is actually
# pointed at a real OpenShift API server; otherwise fall back to `kubectl`.
# `oc whoami` alone is NOT a reliable check - it can report a user even
# against a plain/kind/vanilla Kubernetes cluster (it can resolve from the
# local kubeconfig without the server ever confirming it's OpenShift), which
# caused false "Detected OpenShift context" results on non-OpenShift
# clusters. Instead, check for an OpenShift-only API group (route.openshift.io,
# i.e. Routes) which only exists on genuine OpenShift - this requires a real
# round-trip to the API server's discovery endpoint.
KCMD=""
IS_OPENSHIFT=false
if command -v oc &>/dev/null && oc api-resources 2>/dev/null | grep -q 'route.openshift.io'; then
    IS_OPENSHIFT=true
fi

if [ "$IS_OPENSHIFT" = true ]; then
    KCMD="oc"
    echo "Detected OpenShift context - using 'oc' for all cluster commands."
elif command -v kubectl &>/dev/null; then
    KCMD="kubectl"
    echo "Using 'kubectl' for all cluster commands."
elif command -v oc &>/dev/null; then
    # No kubectl available and this isn't confirmed OpenShift either, but oc
    # is still usable for most read verbs against the current kubeconfig.
    KCMD="oc"
    echo "WARNING: 'kubectl' not found and OpenShift not detected - proceeding with 'oc' anyway."
else
    echo "ERROR: Neither 'oc' nor 'kubectl' found. Please install one and re-run."
    exit 1
fi

# Fail loudly here rather than letting every downstream `kubectl`/`oc` call
# silently swallow the error (they're all `2>/dev/null || true` on purpose,
# so one missing resource type doesn't abort the whole run). Without this
# check, a stale/expired/wrong kubeconfig context - or no context at all -
# doesn't stop the script; it just makes every subsequent command fail
# silently, and the script still "succeeds", producing a full-looking but
# entirely empty diagnostic bundle instead of a clear error up front.
if ! "$KCMD" cluster-info &>/dev/null; then
    echo "ERROR: Cannot reach a Kubernetes API server with the current context." >&2
    echo "       Check 'kubectl config current-context' and 'kubectl cluster-info',"  >&2
    echo "       fix/point your kubeconfig at the right cluster, then re-run." >&2
    exit 1
fi

YQ_AVAILABLE=false
if command -v yq &>/dev/null; then
    YQ_AVAILABLE=true
else
    echo "WARNING: 'yq' not found - cluster YAML will be saved as-is (no field stripping)."
    echo "         Install yq (https://github.com/mikefarah/yq) for a cleaner output."
    echo ""
fi

# Portable replacement for `mapfile`/`readarray` (bash 4+ only). macOS ships
# bash 3.2 by default, which does not have mapfile - this was the root cause
# of the "mapfile: command not found" errors seen when running the plugin.
collect_lines() {
    # usage: collect_lines ARRAY_NAME <<< "$(some command)"
    local __name="$1"
    local __line
    eval "$__name=()"
    while IFS= read -r __line; do
        [[ -z "${__line// /}" ]] && continue
        eval "$__name+=(\"\$__line\")"
    done
}

lower() { echo "$1" | tr '[:upper:]' '[:lower:]'; }

# Exit cleanly from any prompt if the user types q/quit/exit instead of a
# valid choice, rather than silently falling through to a default.
check_quit() {
    case "$1" in
        q|Q|quit|Quit|QUIT|exit|Exit|EXIT)
            echo "Exiting - no diagnostics collected."
            exit 0
            ;;
    esac
}

# Save one container's current + previous logs, both to the nested
# pod-specific location AND to the flat, all-in-one-place $PODLOGS_DIR, so
# logs can be grepped across every pod without walking the whole tree.
#   save_container_log <namespace> <pod> <container> <nested_dir>
save_container_log() {
    local ns="$1" pod="$2" container="$3" nested_dir="$4"
    local flat_name="${ns}__${pod}__${container}"

    "$KCMD" logs "$pod" -n "$ns" -c "$container" \
        > "$nested_dir/${container}.log" 2>/dev/null || true
    "$KCMD" logs "$pod" -n "$ns" -c "$container" --previous \
        > "$nested_dir/${container}_previous.log" 2>/dev/null || true

    cp -f "$nested_dir/${container}.log" "$PODLOGS_DIR/${flat_name}.log" 2>/dev/null || true
    cp -f "$nested_dir/${container}_previous.log" "$PODLOGS_DIR/${flat_name}_previous.log" 2>/dev/null || true
}

# Discover and save every container + init container's logs for a pod.
#   save_all_pod_logs <namespace> <pod> <nested_dir>
save_all_pod_logs() {
    local ns="$1" pod="$2" nested_dir="$3"
    local containers
    containers=$("$KCMD" get pod "$pod" -n "$ns" \
        -o jsonpath='{range .spec.containers[*]}{.name}{" "}{end}{range .spec.initContainers[*]}{.name}{" "}{end}' \
        2>/dev/null)

    if [ -z "$containers" ]; then
        # Fall back to a single unnamed log capture if container discovery
        # itself failed for some reason, so pod-logs is never silently empty.
        "$KCMD" logs "$pod" -n "$ns" > "$nested_dir/pod.log" 2>/dev/null || true
        cp -f "$nested_dir/pod.log" "$PODLOGS_DIR/${ns}__${pod}.log" 2>/dev/null || true
        return
    fi

    for c in $containers; do
        save_container_log "$ns" "$pod" "$c" "$nested_dir"
    done
}

# Different `pgd` CLI builds have used different subcommand spellings for
# the same information (e.g. noun+verb "nodes list"/"cluster verify" on some
# builds, "nodes show"/"verify-cluster" on others, and legacy flat
# "show-nodes"/"check-health" on older ones) - hardcoding one spelling is
# exactly what broke this earlier (old flat subcommands silently returned
# nothing on current CLI builds, and vice versa). Instead of guessing one
# spelling per pgd/PGD4K version, try each known candidate in order and keep
# whichever actually runs and returns something, on whatever CLI is
# installed on this pod right now.
#   run_pgd_native <namespace> <pod> <dsn_db> <outfile> "<cmd1>|<cmd2>|..."
run_pgd_native() {
    local exec_ns="$1" exec_pod="$2" dsn_db="$3" outfile="$4" candidates="$5"
    local cmd out rc last_out="" last_cmd=""
    local tried=()
    local IFS='|'
    for cmd in $candidates; do
        unset IFS
        tried+=("pgd $cmd")
        # user=postgres is required here, unlike psql calls elsewhere which
        # already pass -U postgres explicitly - without an explicit user,
        # pgd CLI authenticates as the raw OS identity instead. On OpenShift
        # (or any SCC/PSA setup assigning an arbitrary non-root UID to the
        # pod) that OS identity is a random numeric UID, not a real Postgres
        # role, so peer auth over the socket - or password auth if a host is
        # given, forcing TCP - fails outright ("Peer authentication failed
        # for user '1000850000'" / "no password supplied") regardless of
        # which subcommand or database is otherwise correct.
        out=$("$KCMD" exec -n "$exec_ns" "$exec_pod" -c postgres -- \
            pgd $cmd --dsn "user=postgres dbname=${dsn_db}" 2>&1)
        rc=$?
        last_out="$out"
        last_cmd="pgd $cmd"
        if [ $rc -eq 0 ] && [ -n "$(echo "$out" | tr -d '[:space:]')" ]; then
            {
                echo "# Command: ${last_cmd} --dsn \"user=postgres dbname=${dsn_db}\"  (pod: ${exec_ns}/${exec_pod})"
                echo ""
                echo "$out"
            } > "$outfile"
            return 0
        fi
        IFS='|'
    done
    unset IFS
    {
        echo "# None of the candidate commands below produced output on this pod's pgd CLI build:"
        printf '#   %s\n' "${tried[@]}"
        echo "#"
        echo "# Last attempt (${last_cmd} --dsn \"user=postgres dbname=${dsn_db}\") returned:"
        echo "$last_out"
    } > "$outfile"
    return 1
}

# ------------------------------------------------------------
# 1. OPERATOR VARIANT SELECTION (always asked first now)
# ------------------------------------------------------------
IS_PGD=false
if [ -n "$PRESET_VARIANT" ]; then
    case "$PRESET_VARIANT" in
        cnp)   VARIANT_CHOICE=1 ;;
        cnpg)  VARIANT_CHOICE=2 ;;
        pgd4k) VARIANT_CHOICE=3 ;;
        *)
            echo "ERROR: --variant must be one of: cnp, cnpg, pgd4k (got '${PRESET_VARIANT}')." >&2
            exit 1
            ;;
    esac
    echo "Operator Variant (from --variant): ${PRESET_VARIANT}"
else
    echo "Select Operator Variant:"
    echo "  1) EDB Postgres® AI for CloudNativePG™ Cluster (CNP)"
    echo "  2) CloudNativePG™ (CNPG)"
    echo "  3) EDB Postgres® AI for CloudNativePG™ Global Cluster (PGD4K)"
    echo "  q) Quit"
    read -rp "Enter choice [1-3, or q to quit]: " VARIANT_CHOICE
    check_quit "$VARIANT_CHOICE"
fi

case "$VARIANT_CHOICE" in
    1) OP_CMD="cnp"  ;;
    2) OP_CMD="cnpg" ;;
    3) OP_CMD="cnp"; IS_PGD=true ;;
    *) echo "Invalid choice, defaulting to CNPG."; OP_CMD="cnpg" ;;
esac

VARIANT_LABEL="CNP"
[ "$OP_CMD" = "cnpg" ] && VARIANT_LABEL="CNPG"
[ "$IS_PGD" = true ] && VARIANT_LABEL="PGD4K"
VARIANT_LOWER=$(lower "$VARIANT_LABEL")

# CNP/PGD4K and community CNPG register DIFFERENT CRDs that both happen to
# use the Kind "Cluster" (postgresql.k8s.enterprisedb.io for CNP/PGD4K vs
# postgresql.cnpg.io for CNPG). If both operators are installed on the same
# cluster - a perfectly normal setup, not an edge case - the bare short name
# `cluster` becomes ambiguous and `get cluster -A` silently returns nothing
# for either one instead of erroring, breaking discovery entirely. Always
# address the fully-qualified resource name for whichever variant was
# actually selected, so this works whether one or both operators are present.
if [ "$OP_CMD" = "cnpg" ]; then
    CLUSTER_RES="clusters.postgresql.cnpg.io"
    # Community CNPG labels its Backup CRs with cnpg.io/cluster (confirmed
    # in the operator's own source: pkg/utils/labels_annotations.go,
    # ClusterLabelName = "cnpg.io/cluster"). Used below to scope backup
    # collection to just this cluster.
    BACKUP_CLUSTER_LABEL="cnpg.io/cluster"
else
    CLUSTER_RES="clusters.postgresql.k8s.enterprisedb.io"
    # CNP/PGD4K's fork uses k8s.enterprisedb.io/cluster instead - confirmed
    # directly against real Backup CRs on both a CNP cluster and a PGD4K
    # cluster.
    BACKUP_CLUSTER_LABEL="k8s.enterprisedb.io/cluster"
fi

echo ""
echo "=== Discovering ${VARIANT_LABEL} clusters in your Kubernetes context ==="
echo ""

# ------------------------------------------------------------
# 2. CLUSTER DISCOVERY & SCOPE SELECTION
# ------------------------------------------------------------
TARGETS=()   # each entry: "namespace|clustername"

collect_lines ALL_CLUSTERS_RAW <<< "$("$KCMD" get "$CLUSTER_RES" -A --no-headers \
    -o custom-columns="NS:.metadata.namespace,NAME:.metadata.name" 2>/dev/null)"

if [ -n "$PRESET_SCOPE" ]; then
    # Non-interactive path - shared across CNP/CNPG/PGD4K since the cluster
    # discovery above is identical for all three variants. This is what
    # lets the tool be looped unattended across many remote clusters from
    # one login session (see --help for a full example).
    case "$PRESET_SCOPE" in
        all)
            if [ ${#ALL_CLUSTERS_RAW[@]} -eq 0 ]; then
                echo "ERROR: --scope=all given but no ${VARIANT_LABEL} clusters were auto-detected in this context." >&2
                exit 1
            fi
            for entry in "${ALL_CLUSTERS_RAW[@]}"; do
                NS=$(awk '{print $1}' <<< "$entry")
                NAME=$(awk '{print $2}' <<< "$entry")
                TARGETS+=("${NS}|${NAME}")
            done
            ;;
        namespace)
            if [ -z "$PRESET_NAMESPACE" ]; then
                echo "ERROR: --scope=namespace requires --namespace=<name>." >&2
                exit 1
            fi
            for entry in "${ALL_CLUSTERS_RAW[@]}"; do
                NS=$(awk '{print $1}' <<< "$entry")
                NAME=$(awk '{print $2}' <<< "$entry")
                [ "$NS" = "$PRESET_NAMESPACE" ] && TARGETS+=("${NS}|${NAME}")
            done
            if [ ${#TARGETS[@]} -eq 0 ]; then
                echo "ERROR: No ${VARIANT_LABEL} clusters found in namespace '${PRESET_NAMESPACE}'." >&2
                exit 1
            fi
            ;;
        single)
            if [ -z "$PRESET_NAMESPACE" ] || [ -z "$PRESET_CLUSTER" ]; then
                echo "ERROR: --scope=single requires both --namespace=<name> and --cluster=<name>." >&2
                exit 1
            fi
            TARGETS+=("${PRESET_NAMESPACE}|${PRESET_CLUSTER}")
            ;;
        *)
            echo "ERROR: --scope must be one of: all, namespace, single (got '${PRESET_SCOPE}')." >&2
            exit 1
            ;;
    esac
elif [ "$IS_PGD" = true ]; then
    # PGD4K: each BDR/PGD node is its own Cluster CR, so namespace and cluster
    # name are NOT fixed to a single value. Default to discovering every
    # Cluster CR so the whole PGD group gets collected in one pass.
    if [ ${#ALL_CLUSTERS_RAW[@]} -eq 0 ]; then
        echo "No clusters auto-detected. Falling back to manual entry."
        read -rp "Enter the Namespace of the PGD cluster/node (or q to quit): " NAMESPACE
        check_quit "$NAMESPACE"
        read -rp "Enter the Cluster (node) Name (or q to quit): " CLUSTER_NAME
        check_quit "$CLUSTER_NAME"
        TARGETS+=("${NAMESPACE}|${CLUSTER_NAME}")
    else
        echo "Detected PGD4K node clusters:"
        for i in "${!ALL_CLUSTERS_RAW[@]}"; do
            NS=$(awk '{print $1}' <<< "${ALL_CLUSTERS_RAW[$i]}")
            NAME=$(awk '{print $2}' <<< "${ALL_CLUSTERS_RAW[$i]}")
            printf "  %2d) %-30s (namespace: %s)\n" "$((i+1))" "$NAME" "$NS"
        done
        echo ""
        echo "Select scope:"
        echo "  1) Collect ALL PGD4K nodes/clusters listed above (recommended - needed for group-level BDR/Raft diagnostics)"
        echo "  2) Collect only clusters within one specific namespace"
        echo "  3) Enter a single namespace + cluster manually"
        echo "  q) Quit"
        read -rp "Enter choice [1-3, or q] (default 1): " PGD_SCOPE
        check_quit "$PGD_SCOPE"

        case "$PGD_SCOPE" in
            2)
                read -rp "Enter the namespace to scope to: " SCOPE_NS
                check_quit "$SCOPE_NS"
                for entry in "${ALL_CLUSTERS_RAW[@]}"; do
                    NS=$(awk '{print $1}' <<< "$entry")
                    NAME=$(awk '{print $2}' <<< "$entry")
                    [ "$NS" = "$SCOPE_NS" ] && TARGETS+=("${NS}|${NAME}")
                done
                ;;
            3)
                read -rp "Enter the Namespace of the Cluster (or q to quit): " NAMESPACE
                check_quit "$NAMESPACE"
                read -rp "Enter the Cluster Name (or q to quit): " CLUSTER_NAME
                check_quit "$CLUSTER_NAME"
                TARGETS+=("${NAMESPACE}|${CLUSTER_NAME}")
                ;;
            *)
                for entry in "${ALL_CLUSTERS_RAW[@]}"; do
                    NS=$(awk '{print $1}' <<< "$entry")
                    NAME=$(awk '{print $2}' <<< "$entry")
                    TARGETS+=("${NS}|${NAME}")
                done
                ;;
        esac
    fi
else
    # CNP / CNPG: ask whether to sweep every cluster in every namespace, or
    # collect just one specific cluster.
    echo "Select collection scope:"
    echo "  1) All ${VARIANT_LABEL} clusters, across all namespaces"
    echo "  2) A specific cluster (you provide namespace + cluster name)"
    echo "  q) Quit"
    read -rp "Enter choice [1, 2, or q]: " SCOPE_CHOICE
    check_quit "$SCOPE_CHOICE"

    if [ "$SCOPE_CHOICE" = "1" ]; then
        if [ ${#ALL_CLUSTERS_RAW[@]} -eq 0 ]; then
            echo "No clusters auto-detected in any namespace."
        fi
        for entry in "${ALL_CLUSTERS_RAW[@]}"; do
            NS=$(awk '{print $1}' <<< "$entry")
            NAME=$(awk '{print $2}' <<< "$entry")
            TARGETS+=("${NS}|${NAME}")
        done
    else
        if [ ${#ALL_CLUSTERS_RAW[@]} -gt 0 ]; then
            echo "Detected clusters:"
            for i in "${!ALL_CLUSTERS_RAW[@]}"; do
                NS=$(awk '{print $1}' <<< "${ALL_CLUSTERS_RAW[$i]}")
                NAME=$(awk '{print $2}' <<< "${ALL_CLUSTERS_RAW[$i]}")
                printf "  %2d) %-30s (namespace: %s)\n" "$((i+1))" "$NAME" "$NS"
            done
            MANUAL_IDX=$(( ${#ALL_CLUSTERS_RAW[@]} + 1 ))
            echo "  ${MANUAL_IDX}) Enter manually"
            echo "  q) Quit"
            read -rp "Select cluster [1-${MANUAL_IDX}, or q]: " SEL
            check_quit "$SEL"
            if [[ "$SEL" =~ ^[0-9]+$ ]] && [ "$SEL" -ge 1 ] && [ "$SEL" -le "${#ALL_CLUSTERS_RAW[@]}" ]; then
                IDX=$(( SEL - 1 ))
                NAMESPACE=$(awk '{print $1}' <<< "${ALL_CLUSTERS_RAW[$IDX]}")
                CLUSTER_NAME=$(awk '{print $2}' <<< "${ALL_CLUSTERS_RAW[$IDX]}")
            else
                read -rp "Enter the Namespace of the Cluster (or q to quit): " NAMESPACE
                check_quit "$NAMESPACE"
                read -rp "Enter the Cluster Name (or q to quit): " CLUSTER_NAME
                check_quit "$CLUSTER_NAME"
            fi
        else
            read -rp "Enter the Namespace of the Cluster (or q to quit): " NAMESPACE
            check_quit "$NAMESPACE"
            read -rp "Enter the Cluster Name (or q to quit): " CLUSTER_NAME
            check_quit "$CLUSTER_NAME"
        fi
        TARGETS+=("${NAMESPACE}|${CLUSTER_NAME}")
    fi
fi

if [ ${#TARGETS[@]} -eq 0 ]; then
    echo "ERROR: No clusters selected for collection. Exiting."
    exit 1
fi

echo ""
echo "Targets to collect (${#TARGETS[@]}):"
for t in "${TARGETS[@]}"; do
    echo "  - namespace=${t%%|*}  cluster=${t##*|}"
done
echo ""

# ------------------------------------------------------------
# 3. DIRECTORY SETUP
# ------------------------------------------------------------
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
if [ ${#TARGETS[@]} -eq 1 ]; then
    MAIN_DIR="edb_diag_${TARGETS[0]##*|}_${TIMESTAMP}"
else
    MAIN_DIR="edb_diag_${VARIANT_LOWER}_multi_${TIMESTAMP}"
fi

PODLOGS_DIR="$MAIN_DIR/pods-logs"

mkdir -p "$MAIN_DIR/operator_info/logs" "$MAIN_DIR/storage" "$MAIN_DIR/clusters" "$PODLOGS_DIR"
[ "$IS_PGD" = true ] && mkdir -p "$MAIN_DIR/pgd_group_info"

for dir in "$MAIN_DIR/operator_info/logs" "$MAIN_DIR/storage" "$MAIN_DIR/clusters" "$PODLOGS_DIR"; do
    if [ ! -d "$dir" ]; then
        echo "ERROR: Failed to create directory: $dir - check permissions and disk space."
        exit 1
    fi
done

echo "Starting comprehensive collection into: ${MAIN_DIR}"
echo "  (all pod logs are also mirrored flat into: ${PODLOGS_DIR})"
echo ""

# ------------------------------------------------------------
# 4. OPERATOR DISCOVERY & VERSIONING (cluster-wide, run once)
# ------------------------------------------------------------
find_op_pod() {
    "$KCMD" get pods -A -l "$1" --no-headers 2>/dev/null | head -n 1
}
find_op_pod_by_name() {
    "$KCMD" get pods -A --no-headers 2>/dev/null | grep -i "$1" | head -n 1
}

echo "Collecting operator-level info..."

OP_POD_INFO=""
if [ "$IS_PGD" = true ]; then
    OP_POD_INFO=$(find_op_pod "app.kubernetes.io/name=edb-postgres-distributed-for-kubernetes")
    [ -z "$OP_POD_INFO" ] && OP_POD_INFO=$(find_op_pod "app.kubernetes.io/name=pgd-operator")
    [ -z "$OP_POD_INFO" ] && OP_POD_INFO=$(find_op_pod_by_name "pgd-operator")
else
    OP_POD_INFO=$(find_op_pod "app.kubernetes.io/name=cloud-native-postgresql")
    [ -z "$OP_POD_INFO" ] && OP_POD_INFO=$(find_op_pod "app.kubernetes.io/name=cloudnativepg")
    [ -z "$OP_POD_INFO" ] && OP_POD_INFO=$(find_op_pod_by_name "cnpg-controller-manager")
fi

if [ -n "$OP_POD_INFO" ]; then
    OP_NS=$(awk '{print $1}' <<< "$OP_POD_INFO")
    OP_POD_NAME=$(awk '{print $2}' <<< "$OP_POD_INFO")
    echo "  Found operator pod: ${OP_POD_NAME} (ns: ${OP_NS})"

    "$KCMD" get pod "$OP_POD_NAME" -n "$OP_NS" \
        -o jsonpath='{.spec.containers[0].image}' \
        > "$MAIN_DIR/operator_info/operator_version.txt" 2>/dev/null || true

    "$KCMD" get deployment -n "$OP_NS" -o yaml \
        > "$MAIN_DIR/operator_info/operator_manifest.yaml" 2>/dev/null || true

    save_all_pod_logs "$OP_NS" "$OP_POD_NAME" "$MAIN_DIR/operator_info/logs"
else
    echo "  WARNING: Operator pod not found - skipping operator-level collection."
fi

# Operator RBAC - RBAC/SCC and OLM-vs-GitOps ClusterRole drift (a GitOps
# snapshot of an OLM-owned ClusterRole reapplied to another cluster) has
# been the actual root cause behind reconciliation-failure tickets that
# initially looked like a pure PGD/BDR problem.
if [ "$IS_PGD" = true ]; then
    "$KCMD" describe clusterrole pgd-operator-manager-role \
        > "$MAIN_DIR/operator_info/operator_clusterrole.txt" 2>/dev/null || true
else
    "$KCMD" describe clusterrole postgresql-operator-manager \
        > "$MAIN_DIR/operator_info/operator_clusterrole.txt" 2>/dev/null || true
fi
"$KCMD" get clusterrole --selector=olm.owner.kind=ClusterServiceVersion -o yaml \
    > "$MAIN_DIR/operator_info/olm_owned_clusterroles.yaml" 2>/dev/null || true
"$KCMD" get clusterrolebinding -o yaml \
    > "$MAIN_DIR/operator_info/clusterrolebindings.yaml" 2>/dev/null || true

BARMAN_POD_INFO=$(find_op_pod_by_name "barman-cloud")
if [ -n "$BARMAN_POD_INFO" ]; then
    B_NS=$(awk '{print $1}' <<< "$BARMAN_POD_INFO")
    B_NAME=$(awk '{print $2}' <<< "$BARMAN_POD_INFO")
    "$KCMD" get pod "$B_NAME" -n "$B_NS" \
        -o jsonpath='{.spec.containers[0].image}' \
        > "$MAIN_DIR/operator_info/barman_plugin_version.txt" 2>/dev/null || true
fi

"$KCMD" get pv > "$MAIN_DIR/storage/all_pv_list.txt" 2>/dev/null || true

# ------------------------------------------------------------
# 5. PER-CLUSTER / PER-POD / PER-DATABASE COLLECTION
# ------------------------------------------------------------
FIRST_PGD_POD_NS=""
FIRST_PGD_POD_NAME=""
FIRST_PGD_POD_DB=""

collect_cluster() {
    local NAMESPACE="$1"
    local CLUSTER_NAME="$2"
    local CDIR="$MAIN_DIR/clusters/${NAMESPACE}__${CLUSTER_NAME}"
    mkdir -p "$CDIR/cluster_info" "$CDIR/pods"

    echo "=== Collecting cluster: ${NAMESPACE}/${CLUSTER_NAME} ==="

    # ---- Cluster-level diagnostics ----
    if [ "$YQ_AVAILABLE" = true ]; then
        "$KCMD" get "$CLUSTER_RES" "$CLUSTER_NAME" -n "$NAMESPACE" -o yaml 2>/dev/null | \
            yq 'del(.status,
                    .metadata.uid,
                    .metadata.selfLink,
                    .metadata.resourceVersion,
                    .metadata.creationTimestamp,
                    .metadata.generation,
                    .metadata.managedFields)' \
            > "$CDIR/cluster_info/cluster_definition_clean.yaml" 2>/dev/null || true
    fi

    "$KCMD" get "$CLUSTER_RES" "$CLUSTER_NAME" -n "$NAMESPACE" -o yaml \
        > "$CDIR/cluster_info/cluster_definition_full.yaml" 2>/dev/null || true

    "$KCMD" "$OP_CMD" status "$CLUSTER_NAME" -n "$NAMESPACE" \
        > "$CDIR/cluster_info/cluster_status.txt" 2>/dev/null || true

    "$KCMD" describe "$CLUSTER_RES" "$CLUSTER_NAME" -n "$NAMESPACE" \
        > "$CDIR/cluster_info/cluster_describe.txt" 2>/dev/null || true

    # Scoped to THIS cluster via the label the operator itself puts on the
    # Backup CR (BACKUP_CLUSTER_LABEL, set above) - an earlier version
    # collected every Backup in the namespace unfiltered, which mixed
    # different clusters' backups together whenever more than one cluster
    # shares a namespace.
    "$KCMD" get backup -n "$NAMESPACE" -l "${BACKUP_CLUSTER_LABEL}=${CLUSTER_NAME}" -o yaml \
        > "$CDIR/cluster_info/backups.yaml" 2>/dev/null || true

    # `kubectl cnp`/`kubectl cnpg` has no "get" verb at all - the plugin only
    # exposes `backup <cluster>` to CREATE a new backup, never to list
    # existing ones. Confirmed directly against a live cluster:
    # `Error: unknown command "get" for "kubectl cnp"`. That error was being
    # silently swallowed by `2>/dev/null || true`, so backups_summary.txt has
    # been an empty file since this line was first written - not a
    # regression, a long-standing latent bug caught by Alexey Shishkin
    # noticing it was empty even with completed backups sitting right there
    # in backups.yaml. Build a genuine summary table from the Backup CRs
    # directly instead - this needs no plugin at all, so it works
    # identically on CNP, CNPG, and PGD4K.
    "$KCMD" get backup -n "$NAMESPACE" -l "${BACKUP_CLUSTER_LABEL}=${CLUSTER_NAME}" \
        -o custom-columns='NAME:.metadata.name,PHASE:.status.phase,METHOD:.status.method,STARTED:.status.startedAt,STOPPED:.status.stoppedAt,ERROR:.status.error' \
        > "$CDIR/cluster_info/backups_summary.txt" 2>/dev/null || true

    # ScheduledBackups and their controller Jobs - a stuck ScheduledBackup
    # (reconciliation loop, "already exists" errors on the target Backup
    # name) or a hung backup Job has been the root cause in real PGD4K cases.
    "$KCMD" get scheduledbackup -n "$NAMESPACE" -o yaml \
        > "$CDIR/cluster_info/scheduledbackups.yaml" 2>/dev/null || true
    "$KCMD" get jobs -n "$NAMESPACE" -o wide \
        > "$CDIR/cluster_info/jobs.txt" 2>/dev/null || true

    # PGDGroupCleanup objects - completed/stuck cleanups are frequently
    # mistaken for (or actually are) the trigger behind a later outage.
    "$KCMD" get pgdgroupcleanups -n "$NAMESPACE" -o yaml \
        > "$CDIR/cluster_info/pgdgroupcleanups.yaml" 2>/dev/null || true

    "$KCMD" get events -n "$NAMESPACE" --sort-by='.lastTimestamp' \
        > "$CDIR/cluster_info/namespace_events.txt" 2>/dev/null || true

    "$KCMD" get pvc -n "$NAMESPACE" \
        > "$CDIR/cluster_info/pvc_list.txt" 2>/dev/null || true

    # Secret *names/types* only (never contents) - to catch missing
    # image-pull secrets (FailedToRetrieveImagePullSecret) without touching
    # credential data.
    "$KCMD" get secrets -n "$NAMESPACE" \
        > "$CDIR/cluster_info/secrets_list.txt" 2>/dev/null || true

    # Namespace definition - carries OpenShift SCC/UID-range annotations
    # (openshift.io/sa.scc.uid-range, supplemental-groups) that matter when
    # diagnosing "chmod ... operation not permitted" PGDATA ownership issues.
    "$KCMD" get namespace "$NAMESPACE" -o yaml \
        > "$CDIR/cluster_info/namespace_definition.yaml" 2>/dev/null || true

    # ---- Pod discovery ----
    local PODS
    PODS=$("$KCMD" get pods -n "$NAMESPACE" -l "cnpg.io/cluster=$CLUSTER_NAME" \
        -o jsonpath='{.items[*].metadata.name}' 2>/dev/null)

    if [ -z "$PODS" ]; then
        PODS=$("$KCMD" get pods -n "$NAMESPACE" --no-headers \
            -o custom-columns=":metadata.name" 2>/dev/null | grep "^${CLUSTER_NAME}-" | tr '\n' ' ')
    fi

    if [ -z "$PODS" ]; then
        echo "  WARNING: No pods found for cluster '${CLUSTER_NAME}' in namespace '${NAMESPACE}'."
        return
    fi

    for POD in $PODS; do
        echo "  --- Processing Pod: $POD ---"
        local POD_DIR="$CDIR/pods/$POD"
        mkdir -p "$POD_DIR/postgresql"

        "$KCMD" describe pod "$POD" -n "$NAMESPACE" \
            > "$POD_DIR/describe_result.txt" 2>/dev/null || true

        # OpenShift SCC + assigned UID (empty/no-op on vanilla Kubernetes) -
        # needed to confirm a pod's assigned UID against the PV's on-disk
        # PGDATA ownership when diagnosing "chmod: operation not permitted".
        "$KCMD" get pod "$POD" -n "$NAMESPACE" \
            -o jsonpath='{.metadata.annotations.openshift\.io/scc}{"\n"}{.spec.securityContext}{"\n"}' \
            > "$POD_DIR/scc_and_security_context.txt" 2>/dev/null || true

        # Logs for every container/init container on the pod - not just
        # "postgres" - so PGD4K sidecars aren't silently skipped. Saved both
        # nested here AND flat into $PODLOGS_DIR.
        save_all_pod_logs "$NAMESPACE" "$POD" "$POD_DIR/postgresql"

        run_pod_sql() {
            "$KCMD" exec -n "$NAMESPACE" "$POD" -c postgres -- \
                psql -U postgres -c "$1" > "$POD_DIR/postgresql/$2" 2>/dev/null || true
        }

        # Discovered here (rather than after the PGD block below) because
        # PGD_DB discovery, right below, needs this list to find which
        # database actually has the bdr extension.
        local DB_LIST
        DB_LIST=$("$KCMD" exec -n "$NAMESPACE" "$POD" -c postgres -- \
            psql -U postgres -t -c \
            "SELECT datname FROM pg_database WHERE datallowconn AND datname NOT LIKE 'template%';" \
            2>/dev/null | xargs)

        run_pod_sql "SELECT version();"                  "db_version.out"
        run_pod_sql "SHOW ALL;"                           "show_all.out"
        run_pod_sql "SELECT * FROM pg_stat_replication;"  "replication.out"
        run_pod_sql "SELECT * FROM pg_stat_bgwriter;"     "bgwriter.out"
        run_pod_sql "SELECT * FROM pg_stat_archiver;"     "archiver.out"
        run_pod_sql "SELECT * FROM pg_stat_subscription;" "pg_stat_subscription.out"

        # Slot detail + the WAL each one is anchoring. inactive_since resets
        # easily and is not reliable on its own for how long a slot has been
        # stuck - restart_lsn lag (cross-checked against bdr.group_replslots_details
        # below on PGD) is the number to trust.
        run_pod_sql "SELECT slot_name, slot_type, plugin, database, active, \
inactive_since, restart_lsn, confirmed_flush_lsn, \
pg_size_pretty(pg_wal_lsn_diff(pg_current_wal_lsn(), restart_lsn)) AS retained_wal \
FROM pg_replication_slots;" "replication_slots.out"

        # Role OIDs - on a multi-master BDR/PGD group, the same role name
        # existing with a DIFFERENT oid on each node means it was created
        # locally on each node instead of replicated via one DDL statement.
        # That mismatch is exactly what causes "role already exists" /
        # "writer with pid ... has died" replay loops after a reconnect.
        run_pod_sql "SELECT rolname, oid FROM pg_roles ORDER BY rolname;" "pg_roles.out"

        QUERY_ACT="SELECT COALESCE(state,'internal/background') AS state, count(*) \
FROM pg_stat_activity GROUP BY 1 \
UNION ALL SELECT 'Total', count(*) FROM pg_stat_activity \
ORDER BY (state='Total') ASC, count DESC;"
        run_pod_sql "$QUERY_ACT" "activity_counts.out"

        # ---- PGD4K / BDR per-node diagnostics ----
        # Schema names/views below follow EDB Postgres Distributed's `bdr.*`
        # monitoring catalog. Adjust the schema name here if a future PGD
        # version renames it (e.g. to `spock.*`).
        if [ "$IS_PGD" = true ]; then
            # BDR/PGD is enabled per-database, and it is NOT guaranteed to be
            # the default "postgres" maintenance database that run_pod_sql
            # above connects to - querying bdr.* there just silently returns
            # nothing ("schema bdr does not exist", swallowed by 2>/dev/null).
            # Find the real BDR-enabled database by checking each one from
            # DB_LIST above; fall back to "app" (the CNP/PGD4K bootstrap
            # default) if none of them report the extension.
            PGD_DB=""
            for CANDIDATE_DB in $DB_LIST; do
                HAS_BDR=$("$KCMD" exec -n "$NAMESPACE" "$POD" -c postgres -- \
                    psql -U postgres -d "$CANDIDATE_DB" -tA -c \
                    "SELECT 1 FROM pg_extension WHERE extname = 'bdr';" 2>/dev/null)
                if [ "$HAS_BDR" = "1" ]; then
                    PGD_DB="$CANDIDATE_DB"
                    break
                fi
            done
            [ -z "$PGD_DB" ] && PGD_DB="app"

            run_pod_sql_pgd() {
                "$KCMD" exec -n "$NAMESPACE" "$POD" -c postgres -- \
                    psql -U postgres -d "$PGD_DB" -c "$1" > "$POD_DIR/postgresql/$2" 2>/dev/null || true
            }

            if [ -z "$FIRST_PGD_POD_NAME" ]; then
                FIRST_PGD_POD_NS="$NAMESPACE"
                FIRST_PGD_POD_NAME="$POD"
                FIRST_PGD_POD_DB="$PGD_DB"
            fi

            run_pod_sql_pgd "SELECT * FROM bdr.node_summary;"            "bdr_node_summary.out"
            run_pod_sql_pgd "SELECT * FROM bdr.node_slots;"              "bdr_node_slots.out"
            run_pod_sql_pgd "SELECT * FROM bdr.worker_errors ORDER BY error_time DESC;" \
                                                                      "bdr_worker_errors.out"
            run_pod_sql_pgd "SELECT * FROM bdr.subscription_summary;"    "bdr_subscription_summary.out"
            run_pod_sql_pgd "SELECT * FROM bdr.group_versions_details;"  "bdr_group_versions_details.out"
            run_pod_sql_pgd "SELECT * FROM bdr.group_raft_details;"      "bdr_group_raft_details.out"
            run_pod_sql_pgd "SELECT * FROM bdr.group_replslots_details;" "bdr_group_replslots_details.out"
            run_pod_sql_pgd "SELECT * FROM bdr.event_history WHERE event_type = 'write_leader' \
ORDER BY event_time DESC LIMIT 200;"                                 "bdr_write_leader_history.out"

            # bdr.subscription (per-subscription status, e.g. "down") is the
            # real signal on witness nodes - pg_stat_subscription is always
            # empty there since PGD doesn't use native logical subscriptions.
            run_pod_sql_pgd "SELECT * FROM bdr.subscription;"            "bdr_subscription.out"

            # Has shown *different* rows depending on which node you query -
            # capture it per-pod, not just once for the group, so that
            # inconsistency is visible rather than hidden behind one sample.
            run_pod_sql_pgd "SELECT * FROM bdr.proxy_config_summary ORDER BY proxy_name;" \
                                                                       "bdr_proxy_config_summary.out"

            # pgd CLI version on THIS pod specifically - capture per-pod (not
            # just once for the group) since nodes can briefly run different
            # versions mid rolling-upgrade, and this is the first thing to
            # check if any pgd_* file below comes back empty/unexpected.
            "$KCMD" exec -n "$NAMESPACE" "$POD" -c postgres -- \
                pgd --version > "$POD_DIR/postgresql/pgd_cli_version.out" 2>&1 || true

            # Native CLI, per-node view (complements the one-shot group CLI
            # calls in section 6 below). --dsn must point at PGD_DB, same
            # reasoning as above - without it this silently returns nothing.
            # See run_pgd_native() for why several command spellings are tried.
            run_pgd_native "$NAMESPACE" "$POD" "$PGD_DB" \
                "$POD_DIR/postgresql/pgd_replication_slots.out" \
                "replication show --slots|show-replslots"

            # Dump the ENTIRE bdr schema catalog (every table + view), not
            # just the curated subset picked by hand above. This closes the
            # gap with EDB's internal "Lasso" diagnostic tool, which dumps
            # every bdr.* relation as its own postgresql/dbs/<db>/bdr/*.data
            # file (confirmed against a real Lasso tree listing on ticket
            # #65738: ~110 files) - Alexey Shishkin pointed out these are
            # missing from edbdiag's output (ticket #65602).
            #
            # This is deliberately schema-discovery, not a hand-maintained
            # list of ~110 `run_pod_sql_pgd` calls: the exact set of bdr.*
            # objects differs by PGD version (confirmed directly against
            # real 5.9.4 and 6.4.0 clusters - 6.x adds
            # bdr.analytics_sync_position / bdr.parted_origin_catchup_info*
            # / bdr.stat_receiver_transactions, 5.x has
            # bdr.init_physical_lsn_internal that 6.x doesn't), and a fixed
            # list would silently go stale the next time a PGD release adds
            # or renames a view - the exact kind of drift that broke
            # `pgd commit-scope list` earlier in this script's history.
            #
            # relkind IN ('r','v') only: partitioned parents (relkind 'p',
            # e.g. bdr.conflict_history / bdr.event_history) and their
            # "..._part_<start>_<end>" child partitions are excluded on
            # purpose - selecting from the partitioned parent already reads
            # every partition's rows via a normal inheritance-style scan, so
            # dumping each partition separately would just be redundant and
            # very large. This matches Lasso's own list, which also excludes
            # conflict_history/event_history entirely.
            mkdir -p "$POD_DIR/postgresql/bdr_catalog"
            BDR_ENUM_SQL="SELECT c.relname FROM pg_catalog.pg_class c \
JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace \
WHERE n.nspname = 'bdr' AND c.relkind IN ('r','v') \
AND c.relname !~ '_part_[0-9]+_[0-9]+\$' ORDER BY 1;"
            BDR_OBJECTS=$("$KCMD" exec -n "$NAMESPACE" "$POD" -c postgres -- \
                psql -U postgres -d "$PGD_DB" -tA -c "$BDR_ENUM_SQL" 2>/dev/null)
            if [ -n "$BDR_OBJECTS" ]; then
                for BDR_OBJ in $BDR_OBJECTS; do
                    run_pod_sql_pgd "SELECT * FROM bdr.${BDR_OBJ};" "bdr_catalog/${BDR_OBJ}.out"
                done
            else
                echo "  WARNING: Could not enumerate bdr.* catalog objects on ${POD} - bdr_catalog/ will be empty."
            fi
        fi

        for DB in $DB_LIST; do
            echo "     -> Collecting from Database: $DB"
            local DB_SUBDIR="$POD_DIR/postgresql/db_${DB}"
            mkdir -p "$DB_SUBDIR"

            run_db_sql() {
                "$KCMD" exec -n "$NAMESPACE" "$POD" -c postgres -- \
                    psql -U postgres -d "$DB" -c "$1" > "$DB_SUBDIR/$2" 2>/dev/null || true
            }

            run_db_sql "SELECT * FROM pg_available_extensions WHERE installed_version IS NOT NULL;" \
                "extensions.out"
            run_db_sql "SELECT * FROM pg_stat_user_tables;" "pg_stat_user_tables.out"
            run_db_sql "SELECT relname, n_live_tup, n_dead_tup FROM pg_stat_user_tables ORDER BY 3 DESC;" \
                "table_tuples.out"
            run_db_sql "SELECT schemaname, relname, \
pg_size_pretty(pg_relation_size(relid)) AS actual_size, \
n_dead_tup, last_autovacuum \
FROM pg_stat_all_tables ORDER BY n_dead_tup DESC;" "database_bloat.out"
            run_db_sql "SELECT schemaname, relname, indexrelname, \
pg_size_pretty(pg_relation_size(indexrelid)) AS index_size, idx_scan \
FROM pg_stat_user_indexes ORDER BY pg_relation_size(indexrelid) DESC;" "index_bloat.out"
            run_db_sql "SELECT * FROM pg_locks;" "pg_locks.out"
            run_db_sql "SELECT * FROM pg_stat_activity;" "pg_stat_activity.out"

            BLOCK_Q1="SELECT \
  blocked_locks.pid               AS blocked_pid, \
  blocked_activity.usename        AS blocked_user, \
  now() - blocked_activity.query_start AS blocked_duration, \
  blocking_locks.pid              AS blocking_pid, \
  blocking_activity.usename       AS blocking_user, \
  now() - blocking_activity.query_start AS blocking_duration, \
  blocked_activity.query          AS blocked_statement, \
  blocking_activity.query         AS blocking_statement \
FROM pg_catalog.pg_locks AS blocked_locks \
JOIN pg_catalog.pg_stat_activity AS blocked_activity  ON blocked_activity.pid  = blocked_locks.pid \
JOIN pg_catalog.pg_locks AS blocking_locks \
  ON blocking_locks.locktype = blocked_locks.locktype \
 AND blocking_locks.DATABASE          IS NOT DISTINCT FROM blocked_locks.DATABASE \
 AND blocking_locks.relation          IS NOT DISTINCT FROM blocked_locks.relation \
 AND blocking_locks.page              IS NOT DISTINCT FROM blocked_locks.page \
 AND blocking_locks.tuple             IS NOT DISTINCT FROM blocked_locks.tuple \
 AND blocking_locks.virtualxid        IS NOT DISTINCT FROM blocked_locks.virtualxid \
 AND blocking_locks.transactionid     IS NOT DISTINCT FROM blocked_locks.transactionid \
 AND blocking_locks.classid           IS NOT DISTINCT FROM blocked_locks.classid \
 AND blocking_locks.objid             IS NOT DISTINCT FROM blocked_locks.objid \
 AND blocking_locks.objsubid          IS NOT DISTINCT FROM blocked_locks.objsubid \
 AND blocking_locks.pid != blocked_locks.pid \
JOIN pg_catalog.pg_stat_activity AS blocking_activity ON blocking_activity.pid = blocking_locks.pid \
WHERE NOT blocked_locks.granted;"
            run_db_sql "$BLOCK_Q1" "blocking_analysis_detailed.out"

            BLOCK_Q2="SELECT activity.pid, activity.usename, activity.query, \
  blocking.pid AS blocking_id, blocking.query AS blocking_query \
FROM pg_stat_activity AS activity \
JOIN pg_stat_activity AS blocking ON blocking.pid = ANY(pg_blocking_pids(activity.pid));"
            run_db_sql "$BLOCK_Q2" "blocking_summary.out"
        done
    done
}

for T in "${TARGETS[@]}"; do
    collect_cluster "${T%%|*}" "${T##*|}"
done

# ------------------------------------------------------------
# 6. PGD/BDR GROUP-WIDE DIAGNOSTICS (once, via one representative node)
# ------------------------------------------------------------
if [ "$IS_PGD" = true ] && [ -n "$FIRST_PGD_POD_NAME" ]; then
    echo ""
    echo "=== Collecting PGD/BDR group-wide diagnostics (via ${FIRST_PGD_POD_NAME}) ==="
    GDIR="$MAIN_DIR/pgd_group_info"

    # Native `pgd` CLI - group-wide. --dsn must point at the actual
    # BDR-enabled database (PGD_GROUP_DB, discovered per-pod above; falls
    # back to "app", the CNP/PGD4K bootstrap default) - without it the CLI
    # silently returns empty output. Each line below tries several known
    # subcommand spellings in order (see run_pgd_native()) since different
    # pgd CLI builds have named the same information differently - this is
    # what actually auto-adapts to whatever version is installed, rather
    # than hardcoding one spelling that goes stale the next time EDB renames
    # a subcommand.
    PGD_GROUP_DB="${FIRST_PGD_POD_DB:-app}"

    # Detect the pgd CLI version FIRST, before collecting anything else, so
    # version-specific commands below can be skipped cleanly instead of
    # burning an attempt and leaving a generic "no candidates worked" message.
    # Confirmed by direct testing against real 5.9.4 and 6.4.0 clusters: once
    # `user=postgres` is in the --dsn (see run_pgd_native), every noun+verb
    # subcommand below (cluster show/verify, nodes list, groups list,
    # replication show, raft show, events show) works identically on both
    # versions - the ONLY genuine version difference found is `check-health`,
    # a legacy top-level command that 6.x removed outright.
    PGD_CLI_VERSION_RAW=$("$KCMD" exec -n "$FIRST_PGD_POD_NS" "$FIRST_PGD_POD_NAME" -c postgres -- \
        pgd --version 2>&1)
    echo "$PGD_CLI_VERSION_RAW" > "$GDIR/pgd_cli_version.out"
    PGD_CLI_MAJOR=$(echo "$PGD_CLI_VERSION_RAW" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 | cut -d. -f1)
    if [ -n "$PGD_CLI_MAJOR" ]; then
        echo "  Detected pgd CLI major version: ${PGD_CLI_MAJOR}.x"
    else
        echo "  WARNING: Could not parse pgd CLI version from: ${PGD_CLI_VERSION_RAW}"
    fi

    run_pgd_native "$FIRST_PGD_POD_NS" "$FIRST_PGD_POD_NAME" "$PGD_GROUP_DB" \
        "$GDIR/pgd_cluster_show.out"      "cluster show"
    run_pgd_native "$FIRST_PGD_POD_NS" "$FIRST_PGD_POD_NAME" "$PGD_GROUP_DB" \
        "$GDIR/pgd_cluster_verify.out"    "cluster verify --verbose|verify-cluster"
    run_pgd_native "$FIRST_PGD_POD_NS" "$FIRST_PGD_POD_NAME" "$PGD_GROUP_DB" \
        "$GDIR/pgd_nodes_list.out"        "nodes list|nodes show|show-nodes"
    run_pgd_native "$FIRST_PGD_POD_NS" "$FIRST_PGD_POD_NAME" "$PGD_GROUP_DB" \
        "$GDIR/pgd_groups_list.out"       "groups list|show-groups"
    run_pgd_native "$FIRST_PGD_POD_NS" "$FIRST_PGD_POD_NAME" "$PGD_GROUP_DB" \
        "$GDIR/pgd_replication_show.out"  "replication show|show-replslots"
    run_pgd_native "$FIRST_PGD_POD_NS" "$FIRST_PGD_POD_NAME" "$PGD_GROUP_DB" \
        "$GDIR/pgd_raft_show.out"         "raft show|show-raft"
    run_pgd_native "$FIRST_PGD_POD_NS" "$FIRST_PGD_POD_NAME" "$PGD_GROUP_DB" \
        "$GDIR/pgd_events_show.out"       "events show|show-events"

    # `pgd commit-scope list` is not a valid command on ANY pgd CLI build
    # (confirmed identically broken on both 5.9.4 and 6.4.0) - `commit-scope`
    # requires a specific scope name plus a verb (show/create/update/drop);
    # there is no "list all" verb. Query the underlying catalog directly
    # instead - it works the same on every PGD version, and an empty result
    # is normal/expected on clusters with no custom durability rule defined.
    "$KCMD" exec -n "$FIRST_PGD_POD_NS" "$FIRST_PGD_POD_NAME" -c postgres -- \
        psql -U postgres -d "$PGD_GROUP_DB" -c "SELECT * FROM bdr.commit_scopes;" \
        > "$GDIR/pgd_commit_scopes.out" 2>&1 || true

    # `check-health` was removed as of pgd CLI 6.x (confirmed: present and
    # working on 5.9.4, "unrecognized subcommand" on 6.4.0) - skip it outright
    # once 6.x+ is detected rather than recording a generic failure message.
    if [ -n "$PGD_CLI_MAJOR" ] && [ "$PGD_CLI_MAJOR" -ge 6 ] 2>/dev/null; then
        {
            echo "# Skipped: 'pgd check-health' was removed in pgd CLI 6.x and later"
            echo "# (detected version: ${PGD_CLI_MAJOR}.x). Use pgd_cluster_verify.out instead."
        } > "$GDIR/pgd_check_health.out"
    else
        run_pgd_native "$FIRST_PGD_POD_NS" "$FIRST_PGD_POD_NAME" "$PGD_GROUP_DB" \
            "$GDIR/pgd_check_health.out"  "check-health"
    fi

    "$KCMD" get pgdgroups -A -o yaml > "$GDIR/pgdgroups.yaml" 2>/dev/null || true
    "$KCMD" get pgdgroupcleanups -A -o yaml > "$GDIR/pgdgroupcleanups.yaml" 2>/dev/null || true

    # PGD Proxy is a separate component/Deployment from the data-node pods
    # collected in section 5 above - it needs its own describe+logs, not
    # just the connection routing visible from bdr.proxy_config_summary.
    #
    # This MUST be a label selector, not a name/substring match. An earlier
    # version matched any pod name containing "-proxy-", which was too broad:
    # Kubernetes' own built-in `kube-proxy-<hash>` pods (kube-system, present
    # on every cluster regardless of PGD) also contain that exact substring,
    # so they were being swept into proxy_pods/ alongside the real PGD Proxy
    # pods - noise from a component completely unrelated to PGD. The genuine
    # PGD Proxy StatefulSet pods carry a dedicated operator-set label instead
    # (confirmed against a real PGD Proxy pod: k8s.pgd.enterprisedb.io/group=
    # <group>, k8s.pgd.enterprisedb.io/workloadType=pgd-proxy), which only
    # ever matches the real thing.
    echo "  Collecting PGD Proxy pod diagnostics..."
    mkdir -p "$GDIR/proxy_pods"
    PROXY_PODS_RAW=$("$KCMD" get pods -A -l 'k8s.pgd.enterprisedb.io/workloadType=pgd-proxy' --no-headers 2>/dev/null)
    if [ -n "$PROXY_PODS_RAW" ]; then
        while IFS= read -r line; do
            [ -z "${line// /}" ] && continue
            P_NS=$(awk '{print $1}' <<< "$line")
            P_NAME=$(awk '{print $2}' <<< "$line")
            PDIR="$GDIR/proxy_pods/${P_NS}__${P_NAME}"
            mkdir -p "$PDIR"
            "$KCMD" describe pod "$P_NAME" -n "$P_NS" > "$PDIR/describe_result.txt" 2>/dev/null || true
            save_all_pod_logs "$P_NS" "$P_NAME" "$PDIR"
        done <<< "$PROXY_PODS_RAW"
    else
        echo "  No PGD Proxy pods found (label k8s.pgd.enterprisedb.io/workloadType=pgd-proxy) - this PGD group may not have PGD Proxy deployed."
    fi
fi

# ------------------------------------------------------------
# 7. PACKAGING
# ------------------------------------------------------------
echo "--------------------------------------------------------"
tar -czf "${MAIN_DIR}.tar.gz" "$MAIN_DIR"
rm -rf "$MAIN_DIR"
echo "Collection complete: ${MAIN_DIR}.tar.gz"
